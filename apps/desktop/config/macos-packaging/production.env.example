# Copy to production.env and configure the production service before selecting this preset.
NHS_DESKTOP_APP_ID=com.deepseek.nhs
NHS_DESKTOP_AUTO_UPDATE_ENV=production
NHS_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
NHS_DESKTOP_MACOS_PACK_CONCURRENCY=4
NHS_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
NHS_DESKTOP_MACOS_DOWNLOAD_PROXY=
NHS_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# NHS_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
