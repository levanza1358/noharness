# Copy to production.env in the same machine configuration directory and fill in the values.
NHS_DESKTOP_APP_ID=com.deepseek.nhs
NHS_DESKTOP_AUTO_UPDATE_ENV=production
NHS_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
NHS_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# NHS_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
NHS_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
NHS_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
