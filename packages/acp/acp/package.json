{
  "name": "@noharness/acp",
  "description": "Automation-only Agent Client Protocol server for driving NoHarness agents over JSON-RPC stdio",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@noharness/brand": "workspace:*",
    "@noharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/mcp-client": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/mcp-client": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/user-approval": "workspace:*"
  }
}
