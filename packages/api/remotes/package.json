{
  "name": "@noharness/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dependencies": {
    "@noharness/deque": "workspace:*",
    "@noharness/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/scope": "workspace:*"
  },
  "devDependencies": {
    "@noharness/agent": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/api-gateway": "workspace:*",
    "@noharness/api-job-controller": "workspace:*",
    "@noharness/api-session-controller": "workspace:*",
    "@noharness/api-settings-controller": "workspace:*",
    "@noharness/api-workspace-controller": "workspace:*",
    "@noharness/api-workspace-files": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/client-file-upload": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/cordis-host-runner": "workspace:*",
    "@noharness/credentials": "workspace:*",
    "@noharness/file-reference": "workspace:*",
    "@noharness/goal": "workspace:*",
    "@noharness/host-plugin-inventory": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/message-feedback": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/schedule": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-reference": "workspace:*",
    "@noharness/settings": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/user-approval": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "zod": "4.6.6",
    "@noharness/command-feedback": "workspace:*",
    "@noharness/api-terminal-controller": "workspace:*",
    "@noharness/plugin-manager": "workspace:*",
    "@noharness/mcp-manager": "workspace:*",
    "@noharness/plugin-market": "workspace:*",
    "@noharness/client-ui-plugin-manager": "workspace:*",
    "@noharness/office-kit": "workspace:*",
    "@noharness/deepseek-account": "workspace:*",
    "@noharness/client-product-analytics": "workspace:*",
    "@noharness/client-ui-session-status": "workspace:*",
    "@noharness/agent-team": "workspace:*",
    "@noharness/client-ui-trajectory": "workspace:*",
    "@noharness/web": "workspace:*"
  }
}
