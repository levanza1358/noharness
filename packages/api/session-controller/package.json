{
  "name": "@noharness/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "external": [
        "@noharness/api-gateway/client"
      ],
      "inject": [
        "@noharness/api-gateway",
        "@noharness/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/deque": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-default-model": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/api-gateway": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/client-file-upload": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/credentials": "workspace:*",
    "@noharness/file-reference": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/native-command": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/session-projection-cache": "workspace:*",
    "@noharness/session-query": "workspace:*",
    "@noharness/session-title": "workspace:*",
    "@noharness/settings": "workspace:*",
    "@noharness/skill": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/typert-registry": "workspace:*",
    "@noharness/util-time": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/util-workspace-path": "workspace:*",
    "@noharness/workspace": "workspace:*",
    "@noharness/working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/session-persistence": {
      "optional": true
    },
    "@noharness/session-projection-cache": {
      "optional": true
    },
    "@noharness/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noharness/api-remote-access": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
