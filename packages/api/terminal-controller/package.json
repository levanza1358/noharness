{
  "name": "@noharness/api-terminal-controller",
  "description": "Session-owned interactive terminals with shell discovery, screen recovery and typed Remote control",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/api/terminal-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-gateway"
      ],
      "external": [
        "@noharness/api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@noharness/deque": "workspace:*",
    "@noharness/lazy-require": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@noharness/subprocess": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/api-gateway": "workspace:*",
    "@noharness/brand": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/client-store": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/remote-mock": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/util-crypto": "workspace:*",
    "@noharness/working-directory": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
