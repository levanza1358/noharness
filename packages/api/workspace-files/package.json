{
  "name": "@noharness/api-workspace-files",
  "description": "Workspace file service and Client resource provider: bounded reads, directory listing, and live metadata over the workspaceFiles Remote namespace",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/api/workspace-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-gateway",
        "@noharness/client-resources"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@noharness/deque": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6",
    "@noharness/util-ripgrep": "workspace:*"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/api-gateway": "workspace:*",
    "@noharness/api-remote-access": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/client-resources": "workspace:*",
    "@noharness/client-ui-slots": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/remote-mock": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence": "workspace:*",
    "@noharness/util-workspace-path": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
