{
  "name": "@noharness/attachment-local",
  "description": "Private content-addressed NHS_HOME attachment storage",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/attachment/attachment-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/attachment": "workspace:*",
    "@noharness/home-paths": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/lazy-require": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@noharness/attachment": "workspace:*",
    "@noharness/home-paths": "workspace:*",
    "@noharness/cordis": "workspace:~"
  }
}
