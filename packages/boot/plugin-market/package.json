{
  "name": "@noharness/plugin-market",
  "description": "Configured plugin market indexes for the Web Discover page and the plugin_market agent tool",
  "version": "0.2.2-rc.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/boot/plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/app-boot": "workspace:*",
    "@noharness/atomic-write": "workspace:*",
    "@noharness/brand": "workspace:*",
    "@noharness/package-manifest": "workspace:*",
    "@noharness/plugin-detail": "workspace:*",
    "@noharness/plugin-market-index": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "hosted-git-info": "^9.0.3",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/plugin-manager": "workspace:*",
    "@noharness/settings": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/error": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/cosmokit": "workspace:~",
    "@noharness/app-boot": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/config-editor": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/error": "workspace:*",
    "@noharness/plugin-manager": "workspace:*",
    "@noharness/settings": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@types/hosted-git-info": "^3.0.5",
    "@types/semver": "^7.8.0"
  }
}
