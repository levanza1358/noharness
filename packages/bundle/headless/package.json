{
  "name": "@noharness/headless",
  "description": "The nhs one-shot bundle: a direct core Agent/Session runner over nhs-base with no Host, HTTP, or browser layer",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cmdline": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-default-model": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-query": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/user-approval": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-default-model": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-query": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/permission-presets": {
      "optional": true
    },
    "@noharness/sandbox-policy": {
      "optional": true
    },
    "@noharness/subagent": {
      "optional": true
    }
  }
}
