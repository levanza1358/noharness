{
  "name": "@noharness/sdk-app",
  "description": "The nhs SDK profile bundle: stdio JSON-RPC serving and process lifecycle over nhs-base",
  "version": "0.2.2-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@noharness/cmdline": "workspace:*",
    "@noharness/office-kit": "workspace:*",
    "@noharness/sdk-jsonrpc-server": "workspace:*",
    "@noharness/tool-office": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@noharness/skill-office": "workspace:*",
    "@noharness/tool-workspace-dependencies": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/client-file-upload": "workspace:*",
    "@noharness/workspace": "workspace:*",
    "@noharness/schedule": "workspace:*",
    "@noharness/time-context": "workspace:*",
    "@noharness/tool-schedule": "workspace:*",
    "@noharness/tool-ask-user": "workspace:*",
    "@noharness/tool-present": "workspace:*",
    "@noharness/file-reference-local": "workspace:*",
    "@noharness/deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis": "workspace:~"
  }
}
