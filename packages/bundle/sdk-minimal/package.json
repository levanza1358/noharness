{
  "name": "@noharness/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@noharness/cordis-plugin-timer": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/attachment-local": "workspace:*",
    "@noharness/compaction-basic": "workspace:*",
    "@noharness/compaction-image-offload": "workspace:*",
    "@noharness/deepseek-llm-api-extensions": "workspace:*",
    "@noharness/jobs-local": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/llm-deepseek-api-key": "workspace:*",
    "@noharness/llm-retry": "workspace:*",
    "@noharness/mcp-resources": "workspace:*",
    "@noharness/plugin-package-inventory-deepseek": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/sdk-app": "workspace:*",
    "@noharness/sdk-jsonrpc-server": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-checkpoint-policy": "workspace:*",
    "@noharness/session-log-deepseek": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/session-title": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/terminal": "workspace:*",
    "@noharness/terminal-bash": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/tool-bash-persistent": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-fs": "workspace:*",
    "@noharness/tool-pwsh-persistent": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/tool-working-directory": "workspace:*",
    "@noharness/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~"
  }
}
