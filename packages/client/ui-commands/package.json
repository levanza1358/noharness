{
  "name": "@noharness/client-ui-commands",
  "description": "Client command surface: global directory cache, '/' source, three command UI kinds, popupSelect registry",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/client/ui-commands"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-remotes",
        "@noharness/client-locale",
        "@noharness/client-ui-input-trigger",
        "@noharness/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/api-remotes": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/client-locale": "workspace:*",
    "@noharness/client-test-runtime": "workspace:*",
    "@noharness/client-ui-conversation": "workspace:*",
    "@noharness/client-ui-primitives": "workspace:*",
    "@noharness/client-ui-input-trigger": "workspace:*",
    "@noharness/client-ui-slots": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "react": "^18.2.0",
    "@noharness/api-session-controller": "workspace:*",
    "@noharness/client-store": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/client-ui-renderer": "workspace:*",
    "@noharness/client-ui-session": "workspace:*",
    "clsx": "^2.0.0",
    "@noharness/util-text-search": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
