{
  "name": "@noharness/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-session-controller",
        "@noharness/client-file-upload",
        "@noharness/client-locale",
        "@noharness/client-ui-layout",
        "@noharness/client-ui-renderer",
        "@noharness/client-ui-session",
        "@noharness/client-ui-session-status",
        "@noharness/client-ui-settings",
        "@noharness/client-ui-workspace",
        "@noharness/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@noharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/api-remotes": "workspace:*",
    "@noharness/api-session-controller": "workspace:*",
    "@noharness/api-workspace-controller": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/client-locale": "workspace:*",
    "@noharness/client-file-upload": "workspace:*",
    "@noharness/client-store": "workspace:*",
    "@noharness/client-test-runtime": "workspace:*",
    "@noharness/client-ui-layout": "workspace:*",
    "@noharness/client-ui-primitives": "workspace:*",
    "@noharness/client-ui-renderer": "workspace:*",
    "@noharness/client-ui-session": "workspace:*",
    "@noharness/client-ui-session-status": "workspace:*",
    "@noharness/client-ui-settings": "workspace:*",
    "@noharness/client-ui-workspace": "workspace:*",
    "@noharness/client-ui-slots": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/goal": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/llm-retry": "workspace:*",
    "@noharness/plan-mode": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/tool-todo": "workspace:*",
    "@noharness/util-crypto": "workspace:*",
    "@noharness/workspace": "workspace:*",
    "@noharness/file-reference": "workspace:*",
    "@noharness/util-workspace-path": "workspace:*",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "lexical": "^0.49.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@noharness/agent": "workspace:*",
    "@noharness/settings": "workspace:*",
    "@noharness/client-shortcuts": "workspace:*",
    "@noharness/client-product-analytics": "workspace:*",
    "@noharness/message-quotes": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/brand": "workspace:*",
    "zod": "4.6.6",
    "@noharness/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
