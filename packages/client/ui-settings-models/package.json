{
  "name": "@noharness/client-ui-settings-models",
  "description": "Providers and Models settings over existing settings and credential joins",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/client/ui-settings-models"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/client-ui-settings",
        "@noharness/client-locale",
        "@noharness/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/host-webserver": "workspace:*",
    "@noharness/api-remotes": "workspace:*",
    "@noharness/client-locale": "workspace:*",
    "@noharness/client-store": "workspace:*",
    "@noharness/client-test-runtime": "workspace:*",
    "@noharness/client-ui-primitives": "workspace:*",
    "@noharness/client-ui-settings": "workspace:*",
    "@noharness/client-ui-slots": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "react": "^18.2.0",
    "@noharness/client-ui-renderer": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/remote-mock": "workspace:*",
    "@noharness/client-product-analytics": "workspace:*",
    "@noharness/util-text-search": "workspace:*"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
