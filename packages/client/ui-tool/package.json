{
  "name": "@noharness/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-workspace-controller",
        "@noharness/client-connection",
        "@noharness/client-locale",
        "@noharness/client-ui-conversation",
        "@noharness/api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/spill-policy": "workspace:*",
    "@noharness/fs-patch": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-executor-ptc": "workspace:*",
    "@noharness/tool-jobs": "workspace:*",
    "@noharness/tool-session-query": "workspace:*",
    "@noharness/tool-terminal": "workspace:*",
    "@noharness/spill": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/api-remotes": "workspace:*",
    "@noharness/client-connection": "workspace:*",
    "@noharness/client-locale": "workspace:*",
    "@noharness/client-test-runtime": "workspace:*",
    "@noharness/client-ui-conversation": "workspace:*",
    "@noharness/client-ui-primitives": "workspace:*",
    "@noharness/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@noharness/api-workspace-controller": "workspace:*",
    "@noharness/client-ui-chat": "workspace:*",
    "@noharness/client-ui-renderer": "workspace:*",
    "@noharness/client-ui-session": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/util-workspace-path": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@noharness/ptc-runtime": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/client-ui-context-menu": "workspace:*",
    "@noharness/api-session-controller": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ]
}
