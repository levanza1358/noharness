{
  "name": "@noharness/file-reference-local",
  "description": "Local-filesystem ctx.fileReferences provider with bounded fuzzy indexes",
  "version": "0.2.2-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/context/file-reference-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@noharness/agent": "workspace:*",
    "@noharness/file-reference": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/file-reference": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/working-directory": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/session-projection": "workspace:*"
  }
}
