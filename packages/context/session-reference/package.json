{
  "name": "@noharness/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/util-text-search": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/compaction": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/output-retention": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/session-projection-cache": "workspace:*",
    "@noharness/session-query": "workspace:*",
    "@noharness/session-title": "workspace:*",
    "@noharness/spill": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/spill": {
      "optional": true
    },
    "@noharness/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/compaction": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/output-retention": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/session-projection-cache": "workspace:*",
    "@noharness/session-query": "workspace:*",
    "@noharness/session-query-sqlite": "workspace:*",
    "@noharness/session-title": "workspace:*",
    "@noharness/spill": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/spill-local": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-fs": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/working-directory": "workspace:*"
  }
}
