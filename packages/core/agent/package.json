{
  "name": "@noharness/agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the NoHarness",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/llm": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/workspace": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@noharness/workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noharness/llm": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/typert-registry": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/workspace": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "zod": "4.6.6"
  }
}
