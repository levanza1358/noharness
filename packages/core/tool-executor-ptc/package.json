{
  "name": "@noharness/tool-executor-ptc",
  "description": "PTC program execution, tool bindings, and generated SDK prompts",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/core/tool-executor-ptc"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./run-code": {
      "types": "./lib/types/run-code.d.ts",
      "default": "./lib/run-code.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/run-code.js",
    "lib/_chunks/*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/ptc-runtime": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/user-approval": "workspace:*",
    "@noharness/working-directory": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/ptc-runtime": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/user-approval": "workspace:*",
    "@noharness/working-directory": "workspace:*"
  }
}
