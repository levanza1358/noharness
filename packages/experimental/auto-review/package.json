{
  "name": "@noharness/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the NoHarness Auto permission preset",
  "version": "0.2.2-rc.8",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/agent": "workspace:*",
    "@noharness/agent-instructions": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/working-directory": "workspace:*"
  },
  "dependencies": {
    "@noharness/util-values": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-instructions": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/bash-sandbox": "workspace:*",
    "@noharness/compaction": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/fs-observation-policy": "workspace:*",
    "@noharness/fs-sandbox": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/llm-deepseek": "workspace:*",
    "@noharness/llm-deepseek-api-key": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/shell": "workspace:*",
    "@noharness/shell-env": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-bash": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-executor-ptc": "workspace:*",
    "@noharness/tool-fs": "workspace:*",
    "@noharness/tool-subagent": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/user-approval": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
