{
  "name": "@noharness/experimental-browser-use-stagehand-native",
  "description": "Experimental Stagehand browser tools with separately configured native models",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/browser-use-stagehand-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/browser-use": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/error": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@browserbasehq/stagehand": "4.4.0",
    "@noharness/experimental-browser-use-runtime": "workspace:*",
    "@noharness/mcp-client": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6",
    "@noharness/subprocess": "workspace:*",
    "@puppeteer/browsers": "3.2.2"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/attachment-local": "workspace:*",
    "@noharness/browser-use": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "tsx": "^4.23.13",
    "@noharness/error": "workspace:*"
  }
}
