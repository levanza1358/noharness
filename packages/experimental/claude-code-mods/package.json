{
  "name": "@noharness/experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on NoHarness extension points",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/util-crypto": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/storage-domain": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/error": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/storage": "workspace:*",
    "@noharness/storage-domain": "workspace:*",
    "@noharness/storage-json": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/error": "workspace:*"
  }
}
