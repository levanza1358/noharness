{
  "name": "@noharness/experimental-client-ui-forge",
  "description": "Sidebar panel for a Session's change requests, with a worktree option for new Sessions and its Host Remote",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/client-ui-forge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts"
    }
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-remotes",
        "@noharness/client-locale",
        "@noharness/client-ui-conversation",
        "@noharness/client-ui-layout",
        "@noharness/client-ui-plugin-manager",
        "@noharness/client-ui-settings",
        "@noharness/client-ui-sidebar-right",
        "@noharness/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/experimental-worktree": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/experimental-forge": "workspace:*",
    "@noharness/fs": "workspace:*"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~",
    "@noharness/util-values": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.6",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/storage-domain": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/api-remotes": "workspace:*",
    "@noharness/api-session-controller": "workspace:*",
    "@noharness/client-locale": "workspace:*",
    "@noharness/client-store": "workspace:*",
    "@noharness/client-test-runtime": "workspace:*",
    "@noharness/client-ui-conversation": "workspace:*",
    "@noharness/client-ui-layout": "workspace:*",
    "@noharness/client-ui-plugin-manager": "workspace:*",
    "@noharness/client-ui-primitives": "workspace:*",
    "@noharness/client-ui-renderer": "workspace:*",
    "@noharness/client-ui-session": "workspace:*",
    "@noharness/client-ui-settings": "workspace:*",
    "@noharness/client-ui-sidebar-right": "workspace:*",
    "@noharness/client-ui-slots": "workspace:*",
    "@noharness/client-ui-workspace": "workspace:*",
    "@noharness/experimental-forge": "workspace:*",
    "@noharness/experimental-forge-session": "workspace:*",
    "@noharness/experimental-worktree": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/util-workspace-path": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@noharness/timeout": "workspace:*",
    "@noharness/session-projection-cache": "workspace:*",
    "@noharness/session-query": "workspace:*",
    "@noharness/api-remote-access": "workspace:*",
    "@types/picomatch": "^4.0.3",
    "@noharness/brand": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
