{
  "name": "@noharness/creation-recommendations",
  "description": "Create persistent removable interface plugins from explicit conversation needs",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/creation-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./references/*.md": "./references/*.md",
    "./skills/*.md": "./skills/*.md"
  },
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/skill": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/plugin-manager": "workspace:*",
    "@noharness/api-remote-access": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/skill": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/tool-testkit": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "yaml": "^2.9.0",
    "resolve.exports": "^2.0.3",
    "zod": "4.6.6",
    "@noharness/client-ui-creation-recommendations": "workspace:*",
    "@noharness/action-cards": "workspace:*",
    "@noharness/client-ui-action-cards": "workspace:*"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "references/*.md",
    "skills/*.md",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "icon": "./icon.svg"
}
