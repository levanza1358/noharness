{
  "name": "@noharness/cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.2-rc.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "cua-helper.json",
    "native/Package.swift",
    "native/Info.plist",
    "native/NHSComputerUse.icns",
    "native/build_app.py",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/LICENSE.computer-use-icon",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/computer-use": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/user-questions": "workspace:*"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6",
    "@noharness/cua": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "ajv": "^8.20.0",
    "@noharness/working-directory": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/attachment-local": "workspace:*",
    "@noharness/computer-use": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-executor-ptc": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/llm-deepseek": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@noharness/ptc-runtime": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/settings": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/config-editor": "workspace:*",
    "@noharness/hmr": "workspace:*",
    "@noharness/cordis-plugin-timer": "workspace:~",
    "@noharness/storage": "workspace:*",
    "@noharness/storage-json": "workspace:*",
    "@noharness/storage-domain": "workspace:*"
  },
  "scripts": {
    "build:native": "xcrun python3 native/build_app.py",
    "build:icon": "node native/generate_icon.mjs"
  },
  "os": [
    "darwin"
  ]
}
