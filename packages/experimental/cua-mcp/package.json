{
  "name": "@noharness/cua-mcp",
  "description": "Computer Use as an MCP stdio server: a nhs profile bundle that exposes cua_run_code to external agent harnesses",
  "version": "0.2.2-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/cua-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/attachment": "workspace:*",
    "@noharness/app-boot": "workspace:*"
  },
  "dependencies": {
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-preset": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/attachment-local": "workspace:*",
    "@noharness/brand": "workspace:*",
    "@noharness/cmdline": "workspace:*",
    "@noharness/computer-use": "workspace:*",
    "@noharness/cua": "workspace:*",
    "@noharness/fs-sandbox": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/storage": "workspace:*",
    "@noharness/storage-domain": "workspace:*",
    "@noharness/storage-json": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/user-approval": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@modelcontextprotocol/server": "2.2.0",
    "commander": "^15.0.0"
  },
  "optionalDependencies": {
    "@noharness/cua-macos": "workspace:*",
    "@noharness/cua-windows": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/app-boot": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0"
  }
}
