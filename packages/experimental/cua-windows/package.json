{
  "name": "@noharness/cua-windows",
  "description": "Windows C# computer use through shared application and window objects",
  "version": "0.2.2-rc.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/cua-windows"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/computer-use": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "4.6.6",
    "@noharness/cua": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@noharness/native-command": "workspace:*",
    "@noharness/atomic-write": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/attachment-local": "workspace:*",
    "@noharness/computer-use": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/llm-deepseek": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@noharness/ptc-runtime": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/settings": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/config-editor": "workspace:*",
    "@noharness/hmr": "workspace:*",
    "@noharness/cordis-plugin-timer": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "scripts": {
    "build:native": "dotnet publish native/entry/CuaWindows.csproj --configuration Release --self-contained false --output native/bin/local -p:EnableWindowsTargeting=true",
    "build:native:x64": "dotnet publish native/entry/CuaWindows.csproj --configuration Release --runtime win-x64 --self-contained true --output native/bin/win-x64 -p:EnableWindowsTargeting=true",
    "build:native:arm64": "dotnet publish native/entry/CuaWindows.csproj --configuration Release --runtime win-arm64 --self-contained true --output native/bin/win-arm64 -p:EnableWindowsTargeting=true"
  },
  "os": [
    "win32",
    "linux"
  ]
}
