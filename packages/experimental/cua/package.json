{
  "name": "@noharness/cua",
  "description": "Shared Computer Use application objects, authorization, and logged tool execution",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/cua"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api.d.ts",
      "default": "./lib/api.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/remote-types.js"
    },
    "./native-client": {
      "types": "./lib/types/native-client.d.ts",
      "default": "./lib/native-client.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./config": {
      "types": "./lib/types/config.d.ts",
      "default": "./lib/config.js"
    },
    "./native-schema": {
      "types": "./lib/types/native-schema.d.ts",
      "default": "./lib/native-schema.js"
    },
    "./native-build": {
      "types": "./lib/types/native-build.d.ts",
      "default": "./lib/native-build.js"
    },
    "./guidance": {
      "types": "./lib/types/guidance.d.ts",
      "default": "./lib/guidance.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/remote-types.js",
    "lib/api.js",
    "lib/bridge.js",
    "lib/native-client.js",
    "lib/protocol.js",
    "lib/config.js",
    "lib/native-schema.js",
    "lib/native-build.js",
    "lib/guidance.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/error": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/tool-executor-ptc": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6",
    "@noharness/atomic-write": "workspace:*",
    "@noharness/typert-protocol": "workspace:*",
    "@noharness/storage-domain": "workspace:*"
  },
  "devDependencies": {
    "@noharness/computer-use": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-executor-ptc": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/attachment-local": "workspace:*",
    "@noharness/error": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/llm-deepseek": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@noharness/ptc-runtime": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/config-editor": "workspace:*",
    "@noharness/hmr": "workspace:*",
    "@noharness/cordis-plugin-timer": "workspace:~",
    "@noharness/scope": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/api-remotes": "workspace:*",
    "@noharness/api-gateway": "workspace:*",
    "@noharness/client-locale": "workspace:*",
    "@noharness/client-store": "workspace:*",
    "@noharness/client-ui-primitives": "workspace:*",
    "@noharness/client-ui-renderer": "workspace:*",
    "@noharness/client-ui-slots": "workspace:*",
    "@noharness/client-ui-plugin-manager": "workspace:*",
    "@noharness/client-ui-settings": "workspace:*",
    "@noharness/client-ui-layout": "workspace:*",
    "@noharness/client-test-runtime": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.1.0",
    "@noharness/loader-smoke": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/storage": "workspace:*",
    "@noharness/storage-json": "workspace:*",
    "@noharness/client-ui-user-questions": "workspace:*",
    "@noharness/client-ui-approval": "workspace:*",
    "@noharness/client-ui-conversation": "workspace:*"
  },
  "nhs": {
    "client": {
      "inject": [
        "@noharness/api-remotes",
        "@noharness/client-locale",
        "@noharness/client-ui-plugin-manager",
        "@noharness/client-ui-settings",
        "@noharness/client-ui-layout",
        "@noharness/client-ui-user-questions",
        "@noharness/client-ui-approval",
        "@noharness/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
