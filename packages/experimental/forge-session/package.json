{
  "name": "@noharness/experimental-forge-session",
  "description": "Binds change requests to the Session that created, pushed, or tracked them",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/forge-session"
  },
  "dependencies": {
    "@noharness/timeout": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "shell-quote": "^1.12.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/experimental-forge": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/shell": "workspace:*",
    "@noharness/shell-env": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/bash-local": "workspace:*",
    "@noharness/experimental-forge": "workspace:*",
    "@noharness/experimental-forge-github": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/shell-env": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-bash": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/shell": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/tool-executor-ptc": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@noharness/sandbox-local": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/shell": {
      "optional": true
    },
    "@noharness/shell-env": {
      "optional": true
    },
    "@noharness/tools": {
      "optional": true
    },
    "@noharness/sandbox-policy": {
      "optional": true
    }
  }
}
