{
  "name": "@noharness/personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.2-rc.8",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/action-cards": "workspace:*",
    "@noharness/client-ui-action-cards": "workspace:*",
    "@noharness/creation-recommendations": "workspace:*",
    "@noharness/client-ui-creation-recommendations": "workspace:*",
    "@noharness/plugin-recommendations": "workspace:*",
    "@noharness/client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-timer": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/api-remote-access": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/hmr": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/plugin-manager": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/skill": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tools": "workspace:*"
  },
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
