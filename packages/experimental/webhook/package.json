{
  "name": "@noharness/webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed NoHarness Sessions",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/experimental/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-default-model": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-title": "workspace:*",
    "@noharness/workspace": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-default-model": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-title": "workspace:*",
    "@noharness/workspace": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/util-values": "workspace:*"
  }
}
