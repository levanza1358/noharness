{
  "name": "@noharness/fs-local",
  "description": "Local-filesystem implementation of the NoHarness filesystem seam (ctx.fs)",
  "version": "0.2.2-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/fs": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@noharness/schemastery": "workspace:~",
    "@noharness/fs-patch": "workspace:*"
  },
  "devDependencies": {
    "@noharness/fs": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/cordis": "workspace:~"
  }
}
