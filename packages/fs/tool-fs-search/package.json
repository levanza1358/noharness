{
  "name": "@noharness/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.2-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/schemastery": "workspace:~",
    "@noharness/util-ripgrep": "workspace:*"
  },
  "peerDependencies": {
    "@noharness/llm": "workspace:*",
    "@noharness/output-retention": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/spill": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/output-retention": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/spill": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/scope": "workspace:*",
    "@noharness/working-directory": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@vscode/ripgrep": "^1.18.0"
  }
}
