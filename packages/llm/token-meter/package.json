{
  "name": "@noharness/token-meter",
  "description": "Replay-aware token measurement service (ctx.tokenMeter) for the NoHarness",
  "version": "0.2.2-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/llm/token-meter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./estimate": {
      "types": "./lib/types/estimate.d.ts",
      "default": "./lib/types/estimate.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/compaction": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/llm-retry": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/compaction-image-offload": "workspace:*"
  },
  "dependencies": {
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/brand": "workspace:*",
    "@noharness/compaction": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/llm-retry": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/compaction-image-offload": "workspace:*"
  }
}
