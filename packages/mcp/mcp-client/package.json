{
  "name": "@noharness/mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/attachment": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/error": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/mcp-resources": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/credentials": "workspace:*"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.2.0",
    "@noharness/util-values": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/attachment-local": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/error": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@noharness/cordis": "workspace:~",
    "@noharness/http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.6.6",
    "@noharness/mcp-resources": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/credentials": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/mcp-resources": {
      "optional": true
    },
    "@noharness/system-prompt": {
      "optional": true
    },
    "@noharness/credentials": {
      "optional": true
    }
  }
}
