{
  "name": "@noharness/sandbox-local",
  "description": "Local process-sandbox backends for the NoHarness sandbox seam: bwrap, the npm-distributed landlock-run launcher, macOS Seatbelt, or the Windows ACL restricted-token runner — functionally probed, fail-closed",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/sandbox/sandbox-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/session": "workspace:*"
  },
  "dependencies": {
    "@noharness/sandbox-windows-acl": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~",
    "@noharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/session": "workspace:*"
  }
}
