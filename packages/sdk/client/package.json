{
  "name": "@noharness/sdk-client",
  "description": "TypeScript client SDK for driving a NoHarness runtime subprocess over stdio JSON-RPC: the NoHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cli": "workspace:*"
  },
  "peerDependencies": {
    "@noharness/llm": "workspace:*",
    "@noharness/sdk-protocol": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/llm": "workspace:*",
    "@noharness/sdk-protocol": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/experimental-translator": "workspace:*"
  }
}
