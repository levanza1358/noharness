{
  "name": "@noharness/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process NoHarness SDK clients",
  "version": "0.2.2-rc.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/goal": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/llm-deepseek-api-key": "workspace:*",
    "@noharness/schedule": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/sdk-protocol": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/user-approval": "workspace:*",
    "@noharness/user-questions": "workspace:*",
    "@noharness/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/attachment": "workspace:*",
    "@noharness/command-compact": "workspace:*",
    "@noharness/command-goal": "workspace:*",
    "@noharness/commands": "workspace:*",
    "@noharness/compaction-basic": "workspace:*",
    "@noharness/goal": "workspace:*",
    "@noharness/goal-round-driver": "workspace:*",
