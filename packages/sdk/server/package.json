    "@noharness/llm-deepseek-api-key": "workspace:*",
    "@noharness/permission-presets": "workspace:*",
    "@noharness/plan-mode": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/schedule": "workspace:*",
    "@noharness/scope": "workspace:*",
    "@noharness/sdk-protocol": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/shell": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/tool-goal": "workspace:*",
