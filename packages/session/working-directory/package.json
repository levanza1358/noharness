{
  "name": "@noharness/working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/error": "workspace:*"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/user-approval": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tool-working-directory": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/error": "workspace:*"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6"
  }
}
