{
  "name": "@noharness/settings",
  "description": "Abstract user-settings seam (ctx.settings) for the NoHarness",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/brand": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/brand": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@noharness/cordis-plugin-timer": "workspace:~",
    "@noharness/app-boot": "workspace:*",
    "@noharness/hmr": "workspace:*",
    "@noharness/agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@noharness/util-values": "workspace:*",
    "@noharness/config-editor": "workspace:*",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
