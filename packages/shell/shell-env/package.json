{
  "name": "@noharness/shell-env",
  "description": "Tool-independent managed NHS_* shell environment registry",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/shell/shell-env"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/app-boot": "workspace:*",
    "@noharness/home-paths": "workspace:*",
    "@noharness/shell": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/error": "workspace:*"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/home-paths": "workspace:*",
    "@noharness/error": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/shell": "workspace:*",
    "@noharness/tools": "workspace:*"
  }
}
