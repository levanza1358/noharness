{
  "name": "@noharness/skill-filesystem",
  "description": "Local filesystem skill provider for the NoHarness",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/skill/skill-filesystem"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/fs": "workspace:*",
    "@noharness/home-paths": "workspace:*",
    "@noharness/skill": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@noharness/schemastery": "workspace:~",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/fs": "workspace:*",
    "@noharness/home-paths": "workspace:*",
    "@noharness/skill": "workspace:*",
    "@noharness/cordis": "workspace:~"
  }
}
