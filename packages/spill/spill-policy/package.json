{
  "name": "@noharness/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
