{
  "name": "@noharness/spill",
  "description": "Abstract spill storage seam (ctx.spillStore) for the NoHarness — save oversized tool text and return a retrieval locator",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/spill/spill"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/cordis": "workspace:~"
  }
}
