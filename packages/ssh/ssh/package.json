{
  "name": "@noharness/ssh",
  "description": "Shared OpenSSH connection and versioned POSIX remote helper",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/ssh/ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./helper": {
      "types": "./lib/types/helper-entry.d.ts",
      "default": "./lib/helper.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./schemas": {
      "types": "./lib/types/schemas.d.ts",
      "default": "./lib/schemas.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/helper.js",
    "lib/protocol.js",
    "lib/schemas.js",
    "lib/protocol-*.js",
    "lib/schemas-*.js",
    "lib/stream-security-*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/fs": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/fs-sandbox": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/brand": "workspace:*",
    "@noharness/util-values": "workspace:*"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/fs": "workspace:*",
    "@noharness/fs-local": "workspace:*",
    "@noharness/fs-sandbox": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-local": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/ptc-runtime-node": "workspace:*",
    "@noharness/fs-ssh": "workspace:*",
    "@noharness/subprocess-ssh": "workspace:*",
    "@noharness/sandbox-ssh": "workspace:*",
    "@noharness/lsp": "workspace:*",
    "@noharness/lsp-stdio": "workspace:*",
    "@noharness/brand": "workspace:*",
    "@noharness/util-values": "workspace:*"
  }
}
