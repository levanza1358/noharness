{
  "name": "@noharness/subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.2-rc.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/timeout": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@noharness/brand": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "4.6.6",
    "@noharness/tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/loader-smoke": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-checkpoint-policy": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subagent-codex": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/tool-jobs": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*"
  },
  "icon": "./icon.svg"
}
