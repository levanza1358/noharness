{
  "name": "@noharness/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "nhs": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/timeout": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/sdk-protocol": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@noharness/tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-include": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/loader-smoke": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-checkpoint-policy": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/timeout": "workspace:*",
    "@noharness/tool-jobs": "workspace:*",
    "@noharness/tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
