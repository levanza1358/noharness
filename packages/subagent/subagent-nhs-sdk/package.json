{
  "name": "@noharness/subagent-nhs-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child NoHarness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/subagent/subagent-nhs-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/sdk-client": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subprocess": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-instructions": "workspace:*",
    "@noharness/app-boot": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/llm-deepseek": "workspace:*",
    "@noharness/llm-deepseek-api-key": "workspace:*",
    "@noharness/loader-smoke": "workspace:*",
    "@noharness/sdk-client": "workspace:*",
    "@noharness/sdk-protocol": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-checkpoint-policy": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/skill-filesystem": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-subagent": "workspace:*"
  }
}
