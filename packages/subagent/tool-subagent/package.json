{
  "name": "@noharness/tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "version": "0.2.2-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/subagent/tool-subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./model-selection-settings": {
      "types": "./lib/types/model-selection-settings.d.ts",
      "default": "./lib/model-selection-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./model-selection-settings/locale/*.json": "./locale/model-selection-settings/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/model-selection-settings/*.json",
    "lib/index.js",
    "lib/model-selection-settings.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/agent": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@noharness/agent-preset-registry": {
      "optional": true
    }
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@noharness/cordis-plugin-loader": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-preset-registry": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence": "workspace:*",
    "@noharness/session-persistence-jsonl": "workspace:*",
    "@noharness/subagent": "workspace:*",
    "@noharness/subagent-spawn-in-process": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/session-projection": "workspace:*"
  }
}
