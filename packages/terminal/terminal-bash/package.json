{
  "name": "@noharness/terminal-bash",
  "description": "Persistent shell PTY backend over the NoHarness subprocess terminal primitive",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/agent": "workspace:*",
    "@noharness/terminal": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/working-directory": "workspace:*"
  },
  "dependencies": {
    "@noharness/lazy-require": "workspace:*",
    "@noharness/pwsh-local": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/agent-loop-testkit": "workspace:*",
    "@noharness/terminal": "workspace:*",
    "@noharness/sandbox": "workspace:*",
    "@noharness/sandbox-policy": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/session-projection": "workspace:*",
    "@noharness/subprocess": "workspace:*",
    "@noharness/subprocess-local": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/working-directory": "workspace:*"
  }
}
