{
  "name": "@noharness/brand",
  "description": "Stateless branded primitive types for the NoHarness",
  "version": "0.2.2-rc.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/util/brand"
  },
  "type": "module",
  "main": "lib/index.js",
