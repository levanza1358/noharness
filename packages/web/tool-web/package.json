{
  "name": "@noharness/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the NoHarness web capability seam (ctx.web)",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/llm": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/web": "workspace:*"
  },
  "dependencies": {
    "@noharness/output-retention": "workspace:*",
    "@noharness/util-values": "workspace:*",
    "@noharness/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/agent": "workspace:*",
    "@noharness/llm": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/spill-local": "workspace:*",
    "@noharness/spill-policy": "workspace:*",
    "@noharness/system-prompt": "workspace:*",
    "@noharness/tool-call-timeout-policy": "workspace:*",
    "@noharness/tool-executor-native": "workspace:*",
    "@noharness/tool-testkit": "workspace:*",
    "@noharness/tools": "workspace:*",
    "@noharness/web": "workspace:*",
    "@noharness/web-deepseek-api": "workspace:*",
    "@noharness/web-fetch-http": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@noharness/scope": "workspace:*",
    "@noharness/token-meter": "workspace:*",
    "@noharness/launch-environment": "workspace:*"
  }
