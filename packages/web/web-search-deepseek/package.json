{
  "name": "@noharness/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the NoHarness web capability seam (ctx.web)",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/agent": "workspace:*",
    "@noharness/credentials": "workspace:*",
    "@noharness/deepseek-account": "workspace:*",
    "@noharness/launch-environment": "workspace:*",
    "@noharness/llm-deepseek": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/web": "workspace:*",
    "@noharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@noharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@noharness/brand": "workspace:*",
    "@noharness/agent": "workspace:*",
    "@noharness/credentials": "workspace:*",
    "@noharness/credentials-local": "workspace:*",
    "@noharness/deepseek-account": "workspace:*",
    "@noharness/launch-environment": "workspace:*",
    "@noharness/llm-deepseek": "workspace:*",
    "@noharness/session": "workspace:*",
    "@noharness/web": "workspace:*",
    "@noharness/cordis": "workspace:~",
    "@noharness/http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@noharness/deepseek-account": {
      "optional": true
    }
  }
}
