{
  "name": "@noharness/workspace",
  "description": "Workspace entity registry (ctx.workspaceRegistry): durable workspace records with validated session attachment over the domain data form for the NoHarness",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levanza1358/noharness.git",
    "directory": "packages/workspace/workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence": "workspace:*",
    "@noharness/storage": "workspace:*",
    "@noharness/storage-domain": "workspace:*",
    "@noharness/typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@noharness/brand": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@noharness/cordis": "workspace:~",
    "@noharness/session": "workspace:*",
    "@noharness/session-persistence": "workspace:*",
    "@noharness/storage": "workspace:*",
    "@noharness/storage-domain": "workspace:*",
    "@noharness/typert-protocol": "workspace:*"
  }
}
